{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "autoIncrement": true,
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "node": "20.18.0",
      "image": "macos-sequoia-15.6-xcode-16.4",
      "env": {
        "NODE_ENV": "production"
      },
      "cache": {
        "disabled": true
      },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
